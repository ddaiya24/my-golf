# 이 파일을 복사해서 .env.local을 만들고 값을 채운다. .env.local은 Git에 올라가지 않는다.
# 모든 값은 서버 전용이다. VITE_ 로 시작하는 이름을 쓰지 말 것 (브라우저 번들에 들어간다).

# Neon 콘솔 → Connect → 연결 문자열 (Pooled connection 권장).
# 로컬 개발·Preview에서는 테스트용 dev 브랜치의 연결 문자열을 쓴다.
DATABASE_URL=

# Neon 콘솔 → Auth → Configuration 의 Auth URL
NEON_AUTH_BASE_URL=

# 세션 쿠키 서명용 임의 문자열 (32자 이상). 터미널에서: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
